@page "/orcamentos"
@using ERP.Staccato.Shared.Models
@using ERP.Staccato.Frontend.Services
@using System.Globalization
@inject OrcamentoService OrcamentoService
@inject AuthService AuthService
@inject ILogger<Orcamentos> Logger

<PageTitle>Orçamentos - ERP Staccato</PageTitle>

<div class="orcamentos-container">
    <div class="orcamentos-header">
        <h1>Orçamentos</h1>
        <div class="header-buttons">
            <button class="btn-primary" @onclick="CreateOrcamento">
                <span>➕ Criar Orçamento</span>
            </button>
            <button class="btn-secondary" disabled="@(SelectedOrcamento == null)" @onclick="OpenFollowup">
                <span>💬 Followup</span>
            </button>
        </div>
    </div>

    <div class="orcamentos-content">
        {/* Filters */
        <div class="filters-panel">
            <h3>Filtros</h3>

            {/* Status Filter */
            <div class="filter-group">
                <label class="filter-label">
                    <input type="checkbox" @bind="StatusEnabled" />
                    <span>Status</span>
                </label>
                @foreach (var status in StatusOptions)
                {
                    <label class="filter-checkbox">
                        <input
                            type="checkbox"
                            value="@status"
                            @onchange="@((ChangeEventArgs e) => OnStatusChanged(status, (bool)e.Value!))"
                            disabled="@(!StatusEnabled)"
                            checked="@SelectedStatuses.Contains(status)"
                        />
                        <span>@status</span>
                    </label>
                }
            </div>

            {/* Month Filter - Hidden for managers */
            @if (!RoleHelpers.IsGerente(User?.Tipo ?? ""))
            {
                <div class="filter-group">
                    <label class="filter-label">
                        <input type="checkbox" @bind="MesEnabled" />
                        <span>Mês</span>
                    </label>
                    <input
                        type="month"
                        class="filter-input"
                        value="@MesValue"
                        @onchange="@((ChangeEventArgs e) => MesValue = e.Value?.ToString() ?? string.Empty)"
                        disabled="@(!MesEnabled)"
                    />
                </div>
            }

            {/* Store Filter - Hidden for store managers */
            @if (!RoleHelpers.IsGerente(User?.Tipo ?? ""))
            {
                <div class="filter-group">
                    <label class="filter-label">Lojas</label>
                    <select class="filter-select" value="@SelectedLoja" @onchange="@((ChangeEventArgs e) => SelectedLoja = e.Value?.ToString() ?? string.Empty)">
                        <option value="">Todas</option>
                        @foreach (var loja in Lojas)
                        {
                            <option value="@loja.IdLoja">@(loja.Descricao ?? loja.NomeFantasia)</option>
                        }
                    </select>
                </div>
            }

            {/* Vendor Filter - Hidden for vendors */
            @if (!RoleHelpers.IsVendedorOrEspecial(User?.Tipo ?? ""))
            {
                <div class="filter-group">
                    <label class="filter-label">Vendedores</label>
                    <select class="filter-select" value="@SelectedVendedor" @onchange="@((ChangeEventArgs e) => SelectedVendedor = e.Value?.ToString() ?? string.Empty)">
                        <option value="">Todos</option>
                        @foreach (var vendedor in Vendedores)
                        {
                            <option value="@vendedor.IdUsuario">@vendedor.Nome</option>
                        }
                    </select>
                </div>
            }

            {/* Supplier Filter */
            <div class="filter-group">
                <label class="filter-label">Fornecedores</label>
                <select class="filter-select" value="@SelectedFornecedor" @onchange="@((ChangeEventArgs e) => SelectedFornecedor = e.Value?.ToString() ?? string.Empty)">
                    <option value="">Todos</option>
                    @foreach (var fornecedor in Fornecedores)
                    {
                        <option value="@fornecedor.RazaoSocial">@fornecedor.RazaoSocial</option>
                    }
                </select>
            </div>

            {/* Search Filter - Real-time with debouncing */
            <div class="filter-group">
                <label class="filter-label">Buscar</label>
                <input
                    type="text"
                    class="filter-input"
                    placeholder="ID, Cliente, Vendedor..."
                    @bind="SearchText"
                    @onkeyup="OnSearchKeyUpAsync"
                />
            </div>

            {/* My Budgets Filter - Only for vendors */
            @if (RoleHelpers.IsVendedorOrEspecial(User?.Tipo ?? ""))
            {
                <div class="filter-group">
                    <label class="filter-radio">
                        <input type="radio" name="my-budgets" @onchange="@((ChangeEventArgs e) => HandlePropriosOrcamentosChange(e.Value?.ToString() == "true"))" checked="@(!ApenasPropriosOrcamentos)" value="false" />
                        <span>Todos</span>
                    </label>
                    <label class="filter-radio">
                        <input type="radio" name="my-budgets" @onchange="@((ChangeEventArgs e) => HandlePropriosOrcamentosChange(e.Value?.ToString() == "true"))" checked="@ApenasPropriosOrcamentos" value="true" />
                        <span>Próprios</span>
                    </label>
                </div>
            }
        </div>

        {/* Table */
        <div class="table-panel">
            @if (IsLoading)
            {
                <div class="loading-state">
                    <p>Carregando orçamentos...</p>
                </div>
            }
            else if (OrcamentosList == null || OrcamentosList.Count == 0)
            {
                <div class="empty-state">
                    <p>Nenhum orçamento encontrado</p>
                </div>
            }
            else
            {
                <table class="orcamentos-table">
                    <thead>
                        <tr>
                            <th>Status</th>
                            <th>Dias</th>
                            <th>ID</th>
                            <th>Vendedor</th>
                            <th>Cliente</th>
                            <th>Total</th>
                            <th>Semáforo</th>
                            <th>Data</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var orc in OrcamentosList)
                        {
                            <tr
                                class="@("orcamento-row " + GetStatusClass(orc.Status))"
                                @onclick="@(() => SelectOrcamento(orc))"
                                style="cursor: pointer; @(SelectedOrcamento?.IdOrcamento == orc.IdOrcamento ? "background-color: rgba(59, 130, 246, 0.1);" : "")"
                            >
                                <td>
                                    <span class="@("status-badge status-" + orc.Status.ToLower())">
                                        @orc.Status
                                    </span>
                                </td>
                                <td>
                                    <span class="@GetDiasRestantesClass(orc)">
                                        @(GetDiasRestantes(orc))
                                    </span>
                                </td>
                                <td><strong>@orc.IdOrcamento</strong></td>
                                <td>@orc.Vendedor</td>
                                <td>@orc.Cliente</td>
                                <td class="text-right">@orc.Total.ToString("C", CultureInfo.GetCultureInfo("pt-BR"))</td>
                                <td>
                                    <span class="@GetSemaforoClass(orc.Semaforo)">
                                        @GetSemaforoLabel(orc.Semaforo)
                                    </span>
                                </td>
                                <td>@orc.Data.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@code {
    private SessionUser? User;
    private List<OrcamentoListItem> OrcamentosList = new();
    private List<LojaDto> Lojas = new();
    private List<VendedorDto> Vendedores = new();
    private List<FornecedorDto> Fornecedores = new();

    private bool IsLoading = true;
    private OrcamentoListItem? SelectedOrcamento;

    // Filter state
    private bool StatusEnabled = true;
    private HashSet<string> SelectedStatuses = new() { "ATIVO", "EXPIRADO" };
    private bool MesEnabled = false;
    private string MesValue = "";
    private string SelectedLoja = "";
    private string SelectedVendedor = "";
    private string SelectedFornecedor = "";
    private string SearchText = "";
    private bool ApenasPropriosOrcamentos = false;

    private readonly string[] StatusOptions = { "ATIVO", "EXPIRADO", "CANCELADO", "FECHADO", "PERDIDO", "REPLICADO" };

    private CancellationTokenSource? _searchCancelToken;
    private Task? _searchTask;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Get current user
            User = await AuthService.GetCurrentUserAsync();

            // Set defaults based on user type
            if (RoleHelpers.IsAdministrativo(User?.Tipo ?? ""))
            {
                // Auto-enable month filter for admin/administrativo
                var today = DateTime.Now;
                MesValue = today.ToString("yyyy-MM");
                MesEnabled = true;
            }

            if (RoleHelpers.IsVendedorOrEspecial(User?.Tipo ?? ""))
            {
                ApenasPropriosOrcamentos = true;
            }

            // Load dropdown data
            var lojasTask = OrcamentoService.GetLojasAsync();
            var vendedoresTask = OrcamentoService.GetVendedoresAsync();
            var fornecedoresTask = OrcamentoService.GetFornecedoresAsync();

            await Task.WhenAll(lojasTask, vendedoresTask, fornecedoresTask);

            Lojas = await lojasTask;
            Vendedores = await vendedoresTask;
            Fornecedores = await fornecedoresTask;

            // Load initial orcamentos
            await LoadOrcamentos();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing page");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadOrcamentos()
    {
        try
        {
            IsLoading = true;

            var filters = new OrcamentoFilters
            {
                Statuses = StatusEnabled ? SelectedStatuses.ToList() : new(),
                MesAno = MesEnabled && !string.IsNullOrEmpty(MesValue) ? MesValue : null,
                IdLoja = string.IsNullOrEmpty(SelectedLoja) ? null : int.Parse(SelectedLoja),
                IdVendedor = string.IsNullOrEmpty(SelectedVendedor) ? null : int.Parse(SelectedVendedor),
                Fornecedor = string.IsNullOrEmpty(SelectedFornecedor) ? null : SelectedFornecedor,
                Search = string.IsNullOrEmpty(SearchText) ? null : SearchText,
                ApenasPropriosOrcamentos = ApenasPropriosOrcamentos
            };

            OrcamentosList = await OrcamentoService.ListAsync(filters);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading orcamentos");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task ApplyFiltersAsync()
    {
        await LoadOrcamentos();
    }

    private async Task OnStatusChanged(string status, bool isChecked)
    {
        if (isChecked)
            SelectedStatuses.Add(status);
        else
            SelectedStatuses.Remove(status);
        await ApplyFiltersAsync();
    }

    private async Task OnSearchKeyUpAsync(KeyboardEventArgs e)
    {
        // Cancel any pending search task
        _searchCancelToken?.Cancel();
        _searchCancelToken = new CancellationTokenSource();

        try
        {
            // Debounce search: wait 300ms before making request
            _searchTask = Task.Delay(300, _searchCancelToken.Token)
                .ContinueWith(async _ => await LoadOrcamentos(), _searchCancelToken.Token);

            await _searchTask;
        }
        catch (OperationCanceledException)
        {
            // Search was cancelled, ignore
        }
    }

    private void HandlePropriosOrcamentosChange(bool value)
    {
        ApenasPropriosOrcamentos = value;
        _ = ApplyFiltersAsync();
    }

    private void SelectOrcamento(OrcamentoListItem orc)
    {
        SelectedOrcamento = orc;
    }

    private void CreateOrcamento()
    {
        Logger.LogInformation("Create orcamento clicked");
        // TODO: Navigate to create orcamento page
    }

    private void OpenFollowup()
    {
        if (SelectedOrcamento == null)
        {
            Logger.LogWarning("No orcamento selected");
            return;
        }

        Logger.LogInformation($"Open followup for: {SelectedOrcamento.IdOrcamento}");
        // TODO: Open followup dialog
    }

    private string GetStatusClass(string status)
    {
        return status?.ToLower() switch
        {
            "ativo" => "status-ativo",
            "expirado" => "status-expirado",
            "cancelado" => "status-cancelado",
            "fechado" => "status-fechado",
            "perdido" => "status-perdido",
            "replicado" => "status-replicado",
            _ => ""
        };
    }

    private string GetDiasRestantes(OrcamentoListItem orc)
    {
        return orc.DiasRestantes?.ToString() ?? "-";
    }

    private string GetDiasRestantesClass(OrcamentoListItem orc)
    {
        if (!int.TryParse(orc.DiasRestantes, out var dias))
            return "";

        return dias >= 5 ? "dias-green" :
               dias >= 3 ? "dias-yellow" : "dias-red";
    }

    private string GetSemaforoClass(int? semaforo)
    {
        return semaforo switch
        {
            1 => "semaforo-quente",
            2 => "semaforo-morno",
            3 => "semaforo-frio",
            _ => ""
        };
    }

    private string GetSemaforoLabel(int? semaforo)
    {
        return semaforo switch
        {
            1 => "🔴 Quente",
            2 => "🟠 Morno",
            3 => "🔵 Frio",
            _ => "-"
        };
    }
}
