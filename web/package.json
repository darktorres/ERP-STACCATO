{
  "name": "erp-staccato-web",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev -w @erp-staccato/backend",
    "dev:frontend": "npm run dev -w @erp-staccato/frontend",
    "build": "npm run build -w @erp-staccato/shared && npm run build -w @erp-staccato/backend && npm run build -w @erp-staccato/frontend",
    "db:generate": "npm run db:generate -w @erp-staccato/backend",
    "db:push": "npm run db:push -w @erp-staccato/backend",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
