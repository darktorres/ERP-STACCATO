-- ============================================================================
-- DATABASE CLEANUP SCRIPT: Remove Recent Duplicate Normal Products
-- ============================================================================
-- Purpose: Remove 21,624 duplicate normal products created in the last 30 days
-- Date: 2026-01-09
-- Cutoff Date: 2025-12-10 (30 days ago)
--
-- This script:
-- 1. Updates 47,904 references in dependent tables to point to canonical products
-- 2. Migrates validade (expiration dates) from duplicate products to canonical products
-- 3. Deletes 21,624 duplicate normal products from the last 30 days
-- 4. Preserves all special products (estoque, promotions, linked products)
-- 5. Preserves all canonical products and historical data
--
-- ============================================================================

START TRANSACTION;
SET FOREIGN_KEY_CHECKS=0;

-- ============================================================================
-- STEP 1: Update References in Dependent Tables
-- ============================================================================
-- For each recent duplicate product, redirect all references to its canonical
-- (oldest) counterpart created before the 30-day cutoff.

-- TABLE 1: orcamento_has_produto (88 references)
-- Update quotation/budget product references
UPDATE orcamento_has_produto ohp
JOIN produto p30 ON ohp.idProduto = p30.idProduto
JOIN (
  SELECT p_new.idProduto as dup_id,
    MIN(p_old.idProduto) as canonical_id
  FROM produto p_new
  JOIN produto p_old ON
    p_new.idFornecedor = p_old.idFornecedor
    AND p_new.codComercial = p_old.codComercial
    AND IFNULL(p_new.ui, 'NULL') = IFNULL(p_old.ui, 'NULL')
  WHERE p_new.created >= DATE_SUB(NOW(), INTERVAL 30 DAY)
    AND p_new.tipo IS NULL
    AND p_new.idProdutoRelacionado IS NULL
    AND p_old.created < DATE_SUB(NOW(), INTERVAL 30 DAY)
    AND p_old.tipo IS NULL
    AND p_old.idProdutoRelacionado IS NULL
  GROUP BY p_new.idProduto
) mappings ON ohp.idProduto = mappings.dup_id
SET ohp.idProduto = mappings.canonical_id;

-- TABLE 2: pedido_fornecedor_has_produto (2 references)
-- Update purchase order product references (v1)
UPDATE pedido_fornecedor_has_produto pfhp
JOIN produto p30 ON pfhp.idProduto = p30.idProduto
JOIN (
  SELECT p_new.idProduto as dup_id,
    MIN(p_old.idProduto) as canonical_id
  FROM produto p_new
  JOIN produto p_old ON
    p_new.idFornecedor = p_old.idFornecedor
    AND p_new.codComercial = p_old.codComercial
    AND IFNULL(p_new.ui, 'NULL') = IFNULL(p_old.ui, 'NULL')
  WHERE p_new.created >= DATE_SUB(NOW(), INTERVAL 30 DAY)
    AND p_new.tipo IS NULL
    AND p_new.idProdutoRelacionado IS NULL
    AND p_old.created < DATE_SUB(NOW(), INTERVAL 30 DAY)
    AND p_old.tipo IS NULL
    AND p_old.idProdutoRelacionado IS NULL
  GROUP BY p_new.idProduto
) mappings ON pfhp.idProduto = mappings.dup_id
SET pfhp.idProduto = mappings.canonical_id;

-- TABLE 3: venda_has_produto (4 references)
-- Update sales product references (v1)
UPDATE venda_has_produto vhp
JOIN produto p30 ON vhp.idProduto = p30.idProduto
JOIN (
  SELECT p_new.idProduto as dup_id,
    MIN(p_old.idProduto) as canonical_id
  FROM produto p_new
  JOIN produto p_old ON
    p_new.idFornecedor = p_old.idFornecedor
    AND p_new.codComercial = p_old.codComercial
    AND IFNULL(p_new.ui, 'NULL') = IFNULL(p_old.ui, 'NULL')
  WHERE p_new.created >= DATE_SUB(NOW(), INTERVAL 30 DAY)
    AND p_new.tipo IS NULL
    AND p_new.idProdutoRelacionado IS NULL
    AND p_old.created < DATE_SUB(NOW(), INTERVAL 30 DAY)
    AND p_old.tipo IS NULL
    AND p_old.idProdutoRelacionado IS NULL
  GROUP BY p_new.idProduto
) mappings ON vhp.idProduto = mappings.dup_id
SET vhp.idProduto = mappings.canonical_id;

-- TABLE 4: venda_has_produto2 (4 references)
-- Update sales product references (v2)
UPDATE venda_has_produto2 vhp2
JOIN produto p30 ON vhp2.idProduto = p30.idProduto
JOIN (
  SELECT p_new.idProduto as dup_id,
    MIN(p_old.idProduto) as canonical_id
  FROM produto p_new
  JOIN produto p_old ON
    p_new.idFornecedor = p_old.idFornecedor
    AND p_new.codComercial = p_old.codComercial
    AND IFNULL(p_new.ui, 'NULL') = IFNULL(p_old.ui, 'NULL')
  WHERE p_new.created >= DATE_SUB(NOW(), INTERVAL 30 DAY)
    AND p_new.tipo IS NULL
    AND p_new.idProdutoRelacionado IS NULL
    AND p_old.created < DATE_SUB(NOW(), INTERVAL 30 DAY)
    AND p_old.tipo IS NULL
    AND p_old.idProdutoRelacionado IS NULL
  GROUP BY p_new.idProduto
) mappings ON vhp2.idProduto = mappings.dup_id
SET vhp2.idProduto = mappings.canonical_id;

-- TABLE 5: pedido_fornecedor_has_produto2 (2 references)
-- Update purchase order product references (v2)
UPDATE pedido_fornecedor_has_produto2 pfhp2
JOIN produto p30 ON pfhp2.idProduto = p30.idProduto
JOIN (
  SELECT p_new.idProduto as dup_id,
    MIN(p_old.idProduto) as canonical_id
  FROM produto p_new
  JOIN produto p_old ON
    p_new.idFornecedor = p_old.idFornecedor
    AND p_new.codComercial = p_old.codComercial
    AND IFNULL(p_new.ui, 'NULL') = IFNULL(p_old.ui, 'NULL')
  WHERE p_new.created >= DATE_SUB(NOW(), INTERVAL 30 DAY)
    AND p_new.tipo IS NULL
    AND p_new.idProdutoRelacionado IS NULL
    AND p_old.created < DATE_SUB(NOW(), INTERVAL 30 DAY)
    AND p_old.tipo IS NULL
    AND p_old.idProdutoRelacionado IS NULL
  GROUP BY p_new.idProduto
) mappings ON pfhp2.idProduto = mappings.dup_id
SET pfhp2.idProduto = mappings.canonical_id;

-- TABLE 6: produto_has_preco (47,804 references)
-- Update price history references
-- Note: This table has ON DELETE CASCADE, but we update first for consistency
UPDATE produto_has_preco php
JOIN produto p30 ON php.idProduto = p30.idProduto
JOIN (
  SELECT p_new.idProduto as dup_id,
    MIN(p_old.idProduto) as canonical_id
  FROM produto p_new
  JOIN produto p_old ON
    p_new.idFornecedor = p_old.idFornecedor
    AND p_new.codComercial = p_old.codComercial
    AND IFNULL(p_new.ui, 'NULL') = IFNULL(p_old.ui, 'NULL')
  WHERE p_new.created >= DATE_SUB(NOW(), INTERVAL 30 DAY)
    AND p_new.tipo IS NULL
    AND p_new.idProdutoRelacionado IS NULL
    AND p_old.created < DATE_SUB(NOW(), INTERVAL 30 DAY)
    AND p_old.tipo IS NULL
    AND p_old.idProdutoRelacionado IS NULL
  GROUP BY p_new.idProduto
) mappings ON php.idProduto = mappings.dup_id
SET php.idProduto = mappings.canonical_id;

-- ============================================================================
-- STEP 2: Migrate validade from Duplicate Products to Canonical Products
-- ============================================================================
-- Copy expiration dates from newer duplicate products to their older canonical
-- counterparts before deletion to preserve this critical information.

UPDATE produto p_canonical
JOIN (
  SELECT p_new.idProduto as dup_id,
    MIN(p_old.idProduto) as canonical_id,
    p_new.validade as new_validade
  FROM produto p_new
  JOIN produto p_old ON
    p_new.idFornecedor = p_old.idFornecedor
    AND p_new.codComercial = p_old.codComercial
    AND IFNULL(p_new.ui, 'NULL') = IFNULL(p_old.ui, 'NULL')
  WHERE p_new.created >= DATE_SUB(NOW(), INTERVAL 30 DAY)
    AND p_new.tipo IS NULL
    AND p_new.idProdutoRelacionado IS NULL
    AND p_old.created < DATE_SUB(NOW(), INTERVAL 30 DAY)
    AND p_old.tipo IS NULL
    AND p_old.idProdutoRelacionado IS NULL
  GROUP BY p_new.idProduto
) mappings ON p_canonical.idProduto = mappings.canonical_id
SET p_canonical.validade = COALESCE(mappings.new_validade, p_canonical.validade)
WHERE mappings.new_validade IS NOT NULL;

SELECT 'Validade migrated to canonical products' as status, ROW_COUNT() as rows_updated;

-- ============================================================================
-- STEP 3: Delete Duplicate Products
-- ============================================================================
-- Remove all normal products created in the last 30 days that are duplicates
-- of products from before the 30-day cutoff.

-- Create temporary table to identify IDs to delete
CREATE TEMPORARY TABLE ids_to_delete AS
SELECT DISTINCT p_new.idProduto
FROM produto p_new
WHERE p_new.created >= DATE_SUB(NOW(), INTERVAL 30 DAY)
  AND p_new.tipo IS NULL
  AND p_new.idProdutoRelacionado IS NULL
  AND EXISTS (
    SELECT 1
    FROM produto p_old
    WHERE p_old.idFornecedor = p_new.idFornecedor
      AND p_old.codComercial = p_new.codComercial
      AND IFNULL(p_old.ui, 'NULL') = IFNULL(p_new.ui, 'NULL')
      AND p_old.created < DATE_SUB(NOW(), INTERVAL 30 DAY)
      AND p_old.tipo IS NULL
      AND p_old.idProdutoRelacionado IS NULL
  );

-- Delete using temporary table (avoids "can't specify target table" error)
DELETE FROM produto WHERE idProduto IN (SELECT idProduto FROM ids_to_delete);

-- ============================================================================
-- STEP 4: Commit and Verify
-- ============================================================================

COMMIT;
SET FOREIGN_KEY_CHECKS=1;

-- ============================================================================
-- VERIFICATION QUERIES
-- ============================================================================
-- Run these after the script completes to verify the cleanup

-- Check 1: Total product counts
SELECT 'Total products' as metric, COUNT(*) as count FROM produto
UNION ALL
SELECT 'Normal products (no type, no relation)', COUNT(*) FROM produto WHERE tipo IS NULL AND idProdutoRelacionado IS NULL
UNION ALL
SELECT 'Special products (with type or relation)', COUNT(*) FROM produto WHERE tipo IS NOT NULL OR idProdutoRelacionado IS NOT NULL
UNION ALL
SELECT 'Products created in last 30 days', COUNT(*) FROM produto WHERE created >= DATE_SUB(NOW(), INTERVAL 30 DAY);

-- Check 2: Verify no recent duplicates remain
SELECT 'Recent duplicates remaining (should be 0):' as status;
SELECT COUNT(*) as count
FROM produto p_new
WHERE p_new.created >= DATE_SUB(NOW(), INTERVAL 30 DAY)
  AND p_new.tipo IS NULL
  AND p_new.idProdutoRelacionado IS NULL
  AND CONCAT(p_new.idFornecedor, '-', p_new.codComercial, '-', IFNULL(p_new.ui, 'NULL')) IN (
    SELECT CONCAT(p_old.idFornecedor, '-', p_old.codComercial, '-', IFNULL(p_old.ui, 'NULL'))
    FROM produto p_old
    WHERE p_old.created < DATE_SUB(NOW(), INTERVAL 30 DAY)
      AND p_old.tipo IS NULL
      AND p_old.idProdutoRelacionado IS NULL
  );

-- ============================================================================
-- SUMMARY OF CHANGES
-- ============================================================================
-- Before:
--   Total products: 395,244
--   Normal products: 282,425
--   Recent normal products (last 30 days): 21,654
--   Recent duplicates: 21,624
--
-- After:
--   Total products: 373,620
--   Normal products: 260,801
--   Recent normal products: 532 (unique new products only)
--   Recent duplicates deleted: 21,624
--
-- References Updated:
--   orcamento_has_produto: 88
--   pedido_fornecedor_has_produto: 2
--   venda_has_produto: 4
--   venda_has_produto2: 4
--   pedido_fornecedor_has_produto2: 2
--   produto_has_preco: 47,804
--   TOTAL: 47,904
--
-- Preserved:
--   All 112,819 special products (estoque, promotions, linked)
--   All 30 unique new products from last 30 days
--   All older canonical products
--   All historical data before 2025-12-10
--
-- ============================================================================
