###########################
# Application Configuration
###########################
APP_NAME=Staccato-ERP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

###########################
# Database Configuration
###########################
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=staccato_dev
DB_USERNAME=staccato
DB_PASSWORD=secret
DB_SSLMODE=prefer

###########################
# Cache & Session
###########################
CACHE_DRIVER=redis
CACHE_PREFIX=staccato_cache_
CACHE_STORE=redis

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

###########################
# Redis Configuration
###########################
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=phpredis
REDIS_DB=0
REDIS_CACHE_DB=1

###########################
# Queue & Job Processing
###########################
QUEUE_CONNECTION=redis
QUEUE_PREFIX=staccato_queue_

###########################
# Mail Configuration
###########################
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@staccato.local
MAIL_FROM_NAME="Staccato ERP"

###########################
# Broadcasting
###########################
BROADCAST_CONNECTION=log

###########################
# File Storage
###########################
FILESYSTEM_DISK=local
BACKUP_DISK=local
BACKUP_PATH=/backups
BACKUP_RETENTION_DAYS=30

###########################
# AWS S3 (optional)
###########################
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_URLS=false

###########################
# Logging & Monitoring
###########################
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_SLACK_WEBHOOK_URL=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

###########################
# Authentication
###########################
AUTH_PROVIDER=session
LDAP_HOST=
LDAP_PORT=389
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
LDAP_SEARCH_FILTER=

###########################
# Brazilian Integrations
###########################
# NFe Integration (Electronic Invoice)
NFE_ENVIRONMENT=homologacao
NFE_CERTIFICATE_PATH=
NFE_CERTIFICATE_PASSWORD=
NFE_CERTIFICATE_PIN=

# CNAB Integration (Banking)
CNAB_BANK=itau
CNAB_AGENCY=
CNAB_ACCOUNT=
CNAB_DIGIT=

###########################
# Docker-specific Settings
###########################
RUN_MIGRATIONS=true
RUN_SEEDERS=false
CREATE_ADMIN_USER=true

###########################
# Development Tools
###########################
XDEBUG_MODE=develop,debug,coverage
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003
XDEBUG_IDEKEY=vscode

###########################
# Feature Flags
###########################
FEATURE_AUDIT_TRAIL=true
FEATURE_RBAC=true
FEATURE_APPROVAL_WORKFLOW=true
FEATURE_PROGRESSIVE_DISCOUNTS=true
FEATURE_NOTIFICATIONS=true

###########################
# Maintenance Mode
###########################
APP_MAINTENANCE_DRIVER=file

###########################
# Security
###########################
BCRYPT_ROUNDS=12

###########################
# Frontend (Vite)
###########################
VITE_APP_NAME="${APP_NAME}"
