// Prisma schema for ERP Staccato
// This maps to the existing MySQL database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// Maps to: staccato.loja
model Loja {
  idLoja              Int       @id @default(autoincrement()) @db.UnsignedInt
  descricao           String?   @db.VarChar(45)
  nomeFantasia        String    @db.VarChar(45)
  razaoSocial         String    @db.VarChar(60)
  tel                 String    @db.VarChar(18)
  tel2                String?   @db.VarChar(18)
  inscEstadual        String?   @unique @db.VarChar(20)
  sigla               String?   @db.VarChar(4)
  cnpj                String?   @unique @db.VarChar(18)
  codUF               Int       @default(0)
  porcentagemFrete    Decimal   @default(4.0000) @db.Decimal(15, 4)
  valorMinimoFrete    Decimal   @default(80.0000) @db.Decimal(15, 4)
  desativado          Boolean   @default(false)
  created             DateTime  @default(now())
  lastUpdated         DateTime? @updatedAt

  usuarios Usuario[]
  orcamentos Orcamento[]

  @@map("loja")
}

// Maps to: staccato.usuario
model Usuario {
  idUsuario       Int       @id @default(autoincrement()) @db.UnsignedInt
  idLoja          Int       @db.UnsignedInt
  user            String    @unique @db.VarChar(20)
  passwd          String    @db.VarChar(42) // Old password field (deprecated)
  password        String?   @db.VarChar(45) // New password field using SHA_PASSWORD
  tipo            String    @db.VarChar(45)
  nome            String    @db.VarChar(45)
  email           String?   @db.VarChar(150)
  telefone        String?   @db.VarChar(45)
  especialidade   Int?
  regime          String    @default("") @db.VarChar(45)
  banco           String?   @db.VarChar(45)
  agencia         String?   @db.VarChar(45)
  cc              String?   @db.VarChar(45)
  poupanca        Boolean?
  nomeBanco       String?   @db.VarChar(45)
  cpfBanco        String?   @db.VarChar(45)
  cnpjBanco       String?   @db.VarChar(45)
  senhaUsoUnico   String?   @db.VarChar(4) // One-time password for authorization
  valorMinimoFrete Decimal? @db.Decimal(15, 4)
  desativado      Boolean   @default(false)
  created         DateTime  @default(now())
  lastUpdated     DateTime? @updatedAt

  loja       Loja        @relation(fields: [idLoja], references: [idLoja])
  permissoes UsuarioHasPermissao?
  orcamentosVendedor Orcamento[] @relation("VendedorOrcamentos")
  orcamentosConsultor Orcamento[] @relation("ConsultorOrcamentos")

  @@index([idLoja], map: "fk_Usuario_Loja1_idx")
  @@map("usuario")
}

// Maps to: staccato.usuario_has_permissao
model UsuarioHasPermissao {
  idUsuario Int @id @db.UnsignedInt

  // Permission flags - add as needed from the actual table
  // These are examples, adjust based on actual columns
  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario])

  @@map("usuario_has_permissao")
}

// Maps to: staccato.maintenance
model Maintenance {
  id               Int       @id
  lastInvalidated  DateTime? @db.Date
  ultimaConsultaNSU DateTime?
  emManutencao     Boolean?
  created          DateTime  @default(now())
  lastUpdated      DateTime? @updatedAt

  @@map("maintenance")
}

// Maps to: staccato.versao_erp
model VersaoErp {
  id          Int     @id @default(autoincrement())
  versaoAtual String? @db.VarChar(45)

  @@map("versao_erp")
}

// Maps to: staccato.cliente
model Cliente {
  idCliente           Int       @id @default(autoincrement()) @db.UnsignedInt
  nome_razao          String    @db.VarChar(200)
  nomeFantasia        String?   @db.VarChar(100)
  cpfCnpj             String?   @db.VarChar(18)
  inscEstadual        String?   @db.VarChar(20)
  tel                 String?   @db.VarChar(18)
  telCel              String?   @db.VarChar(18)
  email               String?   @db.VarChar(100)
  desativado          Boolean   @default(false)
  created             DateTime  @default(now())
  lastUpdated         DateTime? @updatedAt

  orcamentos Orcamento[]

  @@map("cliente")
}

// Maps to: staccato.profissional
model Profissional {
  idProfissional      Int       @id @default(autoincrement()) @db.UnsignedInt
  nome_razao          String    @db.VarChar(200)
  nomeFantasia        String?   @db.VarChar(100)
  cpfCnpj             String?   @db.VarChar(18)
  tel                 String?   @db.VarChar(18)
  telCel              String?   @db.VarChar(18)
  telCom              String?   @db.VarChar(18)
  email               String?   @db.VarChar(100)
  desativado          Boolean   @default(false)
  created             DateTime  @default(now())
  lastUpdated         DateTime? @updatedAt

  orcamentos Orcamento[]

  @@map("profissional")
}

// Maps to: staccato.orcamento
model Orcamento {
  idOrcamento             String    @id @db.VarChar(20)
  idLoja                  Int       @db.UnsignedInt
  idUsuario               Int       @db.UnsignedInt
  idUsuarioConsultor      Int?      @db.UnsignedInt
  idCliente               Int       @db.UnsignedInt
  idEnderecoEntrega       Int       @db.UnsignedInt
  idProfissional          Int?      @db.UnsignedInt
  data                    DateTime  @db.DateTime
  data2                   String    @db.VarChar(7)  // YYYY-MM format
  validade                Int       @default(7)
  status                  String    @db.VarChar(20)
  subTotalBru             Decimal   @db.Decimal(10, 2)
  subTotalLiq             Decimal   @db.Decimal(10, 2)
  frete                   Decimal   @db.Decimal(10, 2)
  freteManual             Boolean   @default(false)
  descontoPorc            Decimal   @db.Decimal(10, 2)
  descontoReais           Decimal   @db.Decimal(10, 2)
  total                   Decimal   @db.Decimal(10, 2)
  prazoEntrega            Int
  observacao              String?   @db.Text
  replicadoDe             String?   @db.VarChar(20)
  replicadoEm             String?   @db.VarChar(20)
  motivoCancelamento      String?   @db.VarChar(100)
  observacaoCancelamento  String?   @db.Text
  representacao           Boolean   @default(false)
  fornecedores            String?   @db.VarChar(500)
  idFollowup              Int?      @db.UnsignedInt
  created                 DateTime  @default(now())
  lastUpdated             DateTime? @updatedAt

  loja                    Loja            @relation(fields: [idLoja], references: [idLoja])
  vendedor                Usuario         @relation("VendedorOrcamentos", fields: [idUsuario], references: [idUsuario])
  consultor               Usuario?        @relation("ConsultorOrcamentos", fields: [idUsuarioConsultor], references: [idUsuario])
  cliente                 Cliente         @relation(fields: [idCliente], references: [idCliente])
  profissional            Profissional?   @relation(fields: [idProfissional], references: [idProfissional])
  produtos                OrcamentoProduto[]

  @@index([idLoja], map: "fk_Orcamento_Loja_idx")
  @@index([idUsuario], map: "fk_Orcamento_Usuario_idx")
  @@index([idCliente], map: "fk_Orcamento_Cliente_idx")
  @@index([idProfissional], map: "fk_Orcamento_Profissional_idx")
  @@index([status], map: "idx_Orcamento_Status")
  @@index([data2], map: "idx_Orcamento_Data2")
  @@map("orcamento")
}

// Maps to: staccato.orcamento_has_produto
model OrcamentoProduto {
  idOrcamentoProduto  Int       @id @default(autoincrement()) @db.UnsignedInt
  idOrcamento         String    @db.VarChar(20)
  idLoja              Int       @db.UnsignedInt
  idProduto           Int       @db.UnsignedInt
  produto             String    @db.VarChar(200)
  fornecedor          String    @db.VarChar(100)
  codComercial        String    @db.VarChar(50)
  formComercial       String    @db.VarChar(50)
  quant               Decimal   @db.Decimal(10, 4)
  caixas              Decimal   @db.Decimal(10, 4)
  quantCaixa          Decimal   @db.Decimal(10, 4)
  prcUnitario         Decimal   @db.Decimal(10, 2)
  desconto            Decimal   @db.Decimal(10, 2)
  parcial             Decimal   @db.Decimal(10, 2)
  parcialDesc         Decimal   @db.Decimal(10, 2)
  kg                  Decimal   @db.Decimal(10, 4)
  un                  String    @db.VarChar(10)
  obs                 String?   @db.Text
  estoque             Boolean   @default(false)
  promocao            Boolean   @default(false)
  created             DateTime  @default(now())
  lastUpdated         DateTime? @updatedAt

  orcamento           Orcamento @relation(fields: [idOrcamento], references: [idOrcamento])

  @@index([idOrcamento], map: "fk_OrcamentoProduto_Orcamento_idx")
  @@index([idLoja], map: "idx_OrcamentoProduto_Loja")
  @@map("orcamento_has_produto")
}

